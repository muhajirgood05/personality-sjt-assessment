# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=assessment_platform
DB_USER=postgres
DB_PASSWORD=postgres
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server Configuration
PORT=3000
NODE_ENV=development

# Encryption Configuration (AES-256)
# For raw key: generate with `openssl rand -base64 32`
ENCRYPTION_KEY=your-base64-encoded-32-byte-key
ENCRYPTION_KEY_TYPE=passphrase
ENCRYPTION_KEY_SALT=assessment-platform-salt

# TLS Configuration
TLS_ENABLED=false
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CA_PATH=
TLS_MIN_VERSION=TLSv1.2

# Data Retention Configuration
DATA_RETENTION_DAYS=730
DATA_RETENTION_ACTION=archive
DATA_RETENTION_BATCH_SIZE=100
DATA_RETENTION_DRY_RUN=false
