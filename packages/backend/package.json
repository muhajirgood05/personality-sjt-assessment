{
  "name": "@assessment/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for the assessment platform (Fastify + TypeScript)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:migrate:status": "tsx src/db/migrate.ts status"
  },
  "dependencies": {
    "@assessment/shared": "*",
    "@fastify/cookie": "^9.3.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/jwt": "^8.0.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^17.4.2",
    "fastify": "^4.26.0",
    "ioredis": "^5.3.2",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.20.0",
    "puppeteer": "^24.43.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.20.0",
    "@types/puppeteer": "^5.4.7",
    "fast-check": "^3.17.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
